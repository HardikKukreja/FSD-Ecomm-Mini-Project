PORT=5000

# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecommerce_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/ecommerce_db?retryWrites=true&w=majority

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

JWT_EXPIRES_IN=7d

# Your Render frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-frontend.onrender.com
